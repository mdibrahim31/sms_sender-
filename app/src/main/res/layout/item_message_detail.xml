<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background"
    app:contentPadding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMsgBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Message body here..."
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvTxnId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TxnId: N/A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green_dark" />

            <TextView
                android:id="@+id/tvMsgDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- Push single message to DB -->
        <Button
            android:id="@+id/btnPushSingleMsg"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:backgroundTint="@color/primary_green"
            android:text="PUSH TO DB"
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:paddingHorizontal="12dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
