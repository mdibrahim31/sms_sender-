<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="16dp">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SMS Forwarder &amp; Service Selector"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnReload"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RELOAD SMS"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="36dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Supabase Cloud Configured (Build Secret)"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/primary_green_dark"
        android:layout_marginBottom="16dp" />

    <!-- Available Services Card Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_background"
        app:contentPadding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAvailableServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available Services (0)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <!-- Search Bar -->
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp"
                android:hint="Search sender / প্রেরক খুঁজুন (e.g. bKash, NAG...)"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <!-- Active forwarding status & Batch Send Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvActiveForwarding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Forwarding: 0 of 0 services active"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green_dark" />

                <Button
                    android:id="@+id/btnSendSelected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEND SELECTED TO DB"
                    android:textSize="11sp"
                    android:backgroundTint="@color/primary_green"
                    android:textColor="@android:color/white"
                    android:minHeight="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginBottom="12dp" />

            <!-- RecyclerView of sender cards -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSenders"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
